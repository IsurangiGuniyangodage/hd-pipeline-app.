{
  "name": "hd-pipeline-app",
  "version": "1.0.0",
  "description": "Node.js app with CRUD, auth, and CI/CD pipeline for Jenkins + Sonar + Docker",
  "main": "server.js",
  "license": "MIT",
  "author": "Isurangi Thilakshana Guniyangodage",
  "keywords": [
    "express",
    "crud",
    "jenkins",
    "sonar",
    "docker",
    "pipeline"
  ],
  "scripts": {
    "start": "node server.js",
    "build": "echo \"(Node has no compile step; keeping placeholder)\"",
    "test": "jest --runInBand --ci --reporters=default --reporters=jest-junit --coverage",
